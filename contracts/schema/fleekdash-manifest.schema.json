{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fleekdash.com/schemas/fleekdash-manifest.schema.json",
  "title": "FleekDash extension manifest (fleekdash.json)",
  "description": "Mirrors FleekDash\\Extension\\ExtensionManifest::validate(). Place a fleekdash.json in a plugin, mu-plugin, fleeklet or theme directory to be discovered by the Hub.",
  "type": "object",
  "required": ["kind", "id", "name"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor self-description pointer; ignored by the runtime validator."
    },
    "kind": {
      "type": "string",
      "enum": ["compat", "integration", "app", "snippet", "connector"]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9\\-]*$",
      "description": "Lowercase slug; the stable identity across Hub, merger and storage."
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9\\-]+)?$"
    },
    "author": { "type": "string" },
    "author_uri": { "type": "string", "format": "uri" },
    "icon": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "sparkles",
            "message-square",
            "settings",
            "dashboard",
            "users",
            "file",
            "folder",
            "mail",
            "bell",
            "heart",
            "star",
            "search",
            "plus",
            "edit",
            "trash",
            "check",
            "x",
            "menu",
            "more-vertical",
            "briefcase",
            "shopping-cart",
            "credit-card",
            "dollar-sign",
            "trending-up",
            "trending-down",
            "activity",
            "bar-chart",
            "phone",
            "video",
            "mic",
            "send",
            "inbox",
            "archive",
            "tool",
            "wrench",
            "code",
            "terminal",
            "database",
            "server",
            "cloud",
            "download",
            "upload",
            "link",
            "external-link",
            "box",
            "package",
            "layers"
          ]
        },
        { "type": "string", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://.+" }
      ]
    },
    "category": { "type": "string", "default": "plugin" },
    "priority": { "type": "integer", "default": 100 },
    "plugin_file": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9\\-_\\/]+\\.php$",
      "description": "Main plugin file relative to the extension dir. Required for kind compat/integration."
    },
    "theme": { "type": "string" },
    "settings_page_url": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+\\.php(\\?[a-zA-Z0-9_\\-=&%.\\/]*)?$"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wp": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+){0,2}([-+][a-zA-Z0-9.\\-]*)?$"
        },
        "fleekdash": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+){0,2}([-+][a-zA-Z0-9.\\-]*)?$"
        },
        "php": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+){0,2}([-+][a-zA-Z0-9.\\-]*)?$"
        },
        "plugins": {
          "type": "array",
          "items": { "type": "string" }
        },
        "themes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "entry": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[a-zA-Z0-9_\\-\\.\\/]+\\.php$",
      "description": "Snippet entry point: relative .php path, no traversal."
    },
    "settings": { "$ref": "#/definitions/settingsSchema" },
    "sections": {
      "type": "object",
      "description": "Map of target FleekDash settings-section slug → field schema.",
      "additionalProperties": { "$ref": "#/definitions/settingsSchema" }
    },
    "feature_key": { "type": "string" },
    "license_required": { "type": "boolean" },
    "required_tier": { "type": "string" },
    "allowed_roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "preview_link": { "type": "string" },
    "roadmap_link": { "type": "string", "format": "uri" },
    "mode": {
      "type": "string",
      "description": "e.g. \"upcoming\" for non-installable catalog cards."
    },
    "connector_id": {
      "type": "string",
      "description": "kind: integration → WP 7.0 native connector id; resolved to connector_status in the Hub."
    },
    "integration_type": {
      "type": "string",
      "enum": [
        "native",
        "standalone",
        "hybrid",
        "internal",
        "mu-plugin",
        "premium-catalog"
      ],
      "description": "kind: app → registry runtime type; defaults to \"standalone\"."
    },
    "routes": {
      "type": "array",
      "description": "kind: app → declarative iframe routes; registered into the integration registry at runtime. component_url accepts a manifest-relative path, a site-relative path (/…), or an http(s) URL; fleekdash_sdk_url is appended automatically.",
      "items": { "$ref": "#/definitions/route" }
    },
    "pages": {
      "type": "array",
      "description": "kind: app → native dashboard pages. Each entry provisions an AdminPage (schema-v3 blocks snapshot) rendered under /app/<id>/<page-id>; explicit [] prunes provisioned pages. JSON-only key (no imperative page API in v1).",
      "items": { "$ref": "#/definitions/page" }
    },
    "data_sources": {
      "type": "array",
      "description": "kind: app → extension-owned REST resources bound to dashboard widgets via the ext-rest adapter. Ids must be namespaced ext.<manifest-id>.<name>; explicit [] prunes registered sources.",
      "items": { "$ref": "#/definitions/dataSource" }
    }
  },
  "definitions": {
    "page": {
      "type": "object",
      "required": ["id", "title", "content"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Page slug; becomes the route segment /app/<ext-id>/<id> and the provisioned page identity."
        },
        "title": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/properties/icon" },
        "capability": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.\\-]{0,63}$",
          "description": "wp capability required to view the page (fails closed)."
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "description": "Absent → provisioner default (menu zone). zone: menu = sidebar item, dashboard = dashboard tab, none = reachable only via its route.",
          "properties": {
            "zone": { "type": "string", "enum": ["none", "dashboard", "menu"] },
            "order": { "type": "integer", "minimum": 0 },
            "parentId": { "type": "string", "minLength": 1 }
          }
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "description": "v1: only {\"type\": \"native\"} (fd-native schema-v3 page). Absent defaults to native.",
          "properties": {
            "type": { "type": "string", "enum": ["native"] }
          }
        },
        "content": {
          "type": "object",
          "required": ["type", "config"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["blocks"],
              "description": "v1: only \"blocks\" (DashboardPresetSnapshot, schema v3)."
            },
            "config": {
              "type": "object",
              "description": "Schema-v3 dashboard snapshot (sections + widgetPlacements …). Deep-normalized at provision time by AdminPageSanitizer."
            }
          }
        }
      }
    },
    "dataSource": {
      "type": "object",
      "required": ["id", "label", "shape", "rest_route"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ext\\.[a-z0-9][a-z0-9\\-]*\\.[a-z0-9-]+$",
          "description": "Namespaced resource id ext.<manifest-id>.<name>; the runtime validator also enforces the manifest-id prefix."
        },
        "label": { "type": "string", "minLength": 1 },
        "shape": {
          "type": "string",
          "enum": ["metric-cards", "table-rows", "time-series", "geo", "funnel"],
          "description": "Adapter projection contract for the endpoint response."
        },
        "rest_route": {
          "type": "string",
          "pattern": "^/[a-zA-Z0-9\\-_/]+$",
          "description": "Site-relative REST path WITHOUT the /wp-json prefix (same form register_rest_route takes). GET only in v1."
        },
        "queryGroups": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9\\-_:]+$" },
          "description": "Query batching groups (lowercase slugs; colons allowed)."
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.\\-]{0,63}$",
          "description": "wp capability required to read the source (fails closed)."
        },
        "entity": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Entity-table renderer key for table-rows sources (e.g. \"task\")."
        },
        "columns": {
          "type": "array",
          "description": "Explicit column contract for table-rows (v1: no inference).",
          "items": {
            "type": "object",
            "required": ["key", "label"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-\\.]+$" },
              "label": { "type": "string", "minLength": 1 },
              "type": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "description": "Rendering hint (e.g. \"date\", \"number\", \"badge\")."
              }
            }
          }
        },
        "rowActions": {
          "type": "array",
          "items": { "type": "string", "enum": ["view", "edit", "delete", "duplicate"] },
          "uniqueItems": true
        }
      }
    },
    "route": {
      "type": "object",
      "required": ["path", "title", "component_url"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9\\-/]+$",
          "description": "Route slug resolved under #/app/<integration_id>/…, e.g. \"excalidraw/editor\"."
        },
        "title": { "type": "string", "minLength": 1 },
        "component_url": {
          "description": "http(s) URL (scheme case-insensitive), site-relative path (/…, anything except a leading //), or manifest-relative path (no scheme, no .. traversal, no backslash); mirrors the runtime route validator exactly. fleekdash_sdk_url is appended automatically.",
          "anyOf": [
            { "type": "string", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://.+" },
            { "type": "string", "pattern": "^/([^/].*)?$" },
            {
              "type": "string",
              "pattern": "^(?![a-zA-Z][a-zA-Z0-9+.\\-]*:)(?!.*\\.\\.)[^/\\\\][^\\\\]*$"
            }
          ]
        },
        "icon": { "$ref": "#/properties/icon" },
        "permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sandbox_mode": {
          "type": "string",
          "enum": ["strict", "moderate", "none"],
          "description": "Iframe sandbox attr mapping; registry default is \"strict\"."
        }
      }
    },
    "settingsSchema": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "default": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean" },
          "encrypted": { "type": "boolean" },
          "option_key": { "type": "string" },
          "options": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "min": { "type": ["number", "string"] },
          "max": { "type": ["number", "string"] },
          "step": { "type": ["number", "string"] },
          "default": {}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "enum": ["compat", "integration"] } } },
      "then": { "required": ["plugin_file"] }
    }
  ]
}
