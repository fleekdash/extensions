{
  "name": "fleekdash/todo-system",
  "description": "Asana-style task manager for FleekDash, doubling as a live tour of every extension API capability",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "autoload": {
    "psr-4": {
      "FleekDashTodoSystem\\": "includes/"
    }
  },
  "scripts": {
    "install-frontend": "pnpm install --frozen-lockfile",
    "build-frontend": "pnpm run build",
    "verify-dist": "@php scripts/verify-dist.php",
    "build": [
      "Composer\\Config::disableProcessTimeout",
      "@install-frontend",
      "@build-frontend",
      "@verify-dist"
    ]
  },
  "config": {
    "process-timeout": 0,
    "sort-packages": true
  }
}
