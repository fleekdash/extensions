{
  "name": "fleekdash/excalidraw",
  "description": "Excalidraw standalone integration for FleekDash",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "scripts": {
    "install-frontend": "pnpm install --frozen-lockfile",
    "build-frontend": "pnpm run build",
    "verify-dist": "@php scripts/verify-dist.php",
    "build": [
      "Composer\\Config::disableProcessTimeout",
      "@install-frontend",
      "@build-frontend",
      "@verify-dist"
    ]
  },
  "config": {
    "process-timeout": 0,
    "sort-packages": true
  }
}
